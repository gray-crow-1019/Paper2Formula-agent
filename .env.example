# All runtime configuration is loaded from this repository-root file.
# Copy this file to .env; the supplied values are for local development.
APP_ENV=development
CONDA_ENV=paper2formula
# Optional explicit Conda prefix; existing .conda/env is auto-detected.
CONDA_ENV_PREFIX=
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite + files + an in-process dispatcher provide a Docker-free first run.
DATABASE_URL=sqlite:///./data/paper2formula.db
CHECKPOINT_DATABASE_URL=sqlite:///./data/checkpoints.db
STORAGE_BACKEND=local
STORAGE_DIR=./data
QUEUE_BACKEND=local
DISPATCHER_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# This fixed token is intentionally public and for local development only.
AUTH_MODE=development
DEV_AUTH_TOKEN=local-paper2formula-token
DEV_OWNER_ID=local-user
JWT_SECRET=
JWT_ISSUER=paper2formula
JWT_AUDIENCE=paper2formula-api

# Text PDF limits; scanning/OCR is outside this version's supported scope.
MAX_UPLOAD_MB=30
MAX_PAGES=100
MIN_TEXT_CHARS=30
LIBREOFFICE_PATH=soffice
CONVERSION_TIMEOUT=90
TASK_TIMEOUT=1800
TASK_LEASE_SECONDS=120

# heuristic runs without a model key and explicitly sends uncertain facts to review.
# Enable with MODEL_PROVIDER=openai_compatible and matching key, base URL, and vision model name.
# Alibaba Cloud Beijing: MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_PROVIDER=heuristic
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=
MODEL_TIMEOUT=60
MODEL_MAX_CALLS=50
MODEL_MAX_TOKENS=3000

# Vite reads the same .env; only VITE_ values are exposed in the browser.
VITE_API_BASE_URL=/api/v1
VITE_DEV_AUTH_TOKEN=local-paper2formula-token
MCP_TRANSPORT=stdio
TOOL_TRANSPORT=local

# Optional docker compose infrastructure. These credentials are local examples.
POSTGRES_DB=paper2formula
POSTGRES_USER=paper2formula
POSTGRES_PASSWORD=local-paper2formula-database
POSTGRES_PORT=5432
REDIS_PORT=6379
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=paper2formula
S3_SECRET_KEY=local-paper2formula-storage
S3_BUCKET=paper2formula
S3_REGION=us-east-1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z
